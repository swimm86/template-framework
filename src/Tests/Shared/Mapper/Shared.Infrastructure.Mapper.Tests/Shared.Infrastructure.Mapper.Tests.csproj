<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!--
      xunit.v3.extensibility.core нужен только для атрибутов [Fact]/[Trait] в
      базовых классах тестов, используемых через PartialKeyword / Scenario.
      PrivateAssets=all изолирует зависимость от потребителей — у тестовых проектов своя прямая
      ссылка на xunit.v3, который транзитивно тянет extensibility.core.
    -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2">
	   <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\..\..\..\Shared\Dal\Shared.Infrastructure.Dal.EFCore\Shared.Infrastructure.Dal.EFCore.csproj" />
  </ItemGroup>

  <ItemGroup>
	  <Using Include="FluentAssertions" />
	  <Using Include="Xunit" />
  </ItemGroup>

</Project>
